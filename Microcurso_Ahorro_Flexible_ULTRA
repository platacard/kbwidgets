        let s2 = base + 'font-weight:500;border:1px solid #E3E8F1;background:#FFFFFF;color:#2A3140;';
        if (cAns) {
          if (isRight) s2 = base + 'font-weight:600;border:1px solid #BCE8CB;background:#EAF9EF;color:#0F7A38;';
