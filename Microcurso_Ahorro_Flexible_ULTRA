    if (g === 'blanks1') return [1, 2, 3, 4, 5].every(n => this.state.blanks[n]);
    if (g === 'blanks2') return [6, 7].every(n => this.state.blanks[n]) && this.quizOk('m1d2');
    if (g === 'flow') return this.state.c1 === 'ultra' && this.state.c2 === 'regular';
    if (g === 'q3') return this.quizOk('m2b');
    if (g === 'caso') return CASO_QS.every(q => this.state['caso_' + q.id] === q.ok);
