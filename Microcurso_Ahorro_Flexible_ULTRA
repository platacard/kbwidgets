  fireConfetti() {
    clearTimeout(this._confT);
    this.setState({ confetti: false }, () => {
      this.setState({ confetti: true });
      this._confT = setTimeout(() => this.setState({ confetti: false }), 5200);
    });
  }

  quizReady(k) {
    if (k === 'm1c') return Object.keys(this.state.matched).length >= CARACT.length;
    if (k === 'm1d2') return [6, 7].every(n => this.state.blanks[n]);
    if (k === 'm3b') return !!this.state.demoDone || !!this.state.bDone;
    if (k === 'm4b') return (this.state.crmIx || 0) >= 2;
    return !!QUIZ[k];
  }

  quizVals() {
    const st = this.state;
    const k = (SCREENS[st.i] || {}).k;
    const q = QUIZ[k];
    if (!q) return { quizOpen: false, quizOpts: [], quizText: '', quizAnswered: false, quizDone: false, quizFb: '', quizFbStyle: '', closeQuiz: () => {} };
    const sel = st['quiz_' + k];
    const ok = sel === q.ok;
    const blueBtn = (isSel, isRight, answered) => {
      const size = 'width:150px;height:50px;display:inline-flex;align-items:center;justify-content:center;border-radius:14px;font-size:14.5px;font-weight:700;font-family:inherit;cursor:pointer;';
      const b = size + 'border:1.5px solid #2401FE;background:#FFFFFF;color:#2401FE;transition:all .15s;';
      if (!answered) return b;
      if (isRight) return size + 'border:1.5px solid #2401FE;background:#2401FE;color:#fff;';
      if (isSel) return b + 'opacity:.55;border-style:dashed;';
      return b + 'opacity:.4;';
    };
    return {
      quizOpen: this.quizReady(k) && !!st['quizArm_' + k] && !st['quizClosed_' + k],
      quizChip: this.quizReady(k) && !!st['quizArm_' + k] && !!st['quizClosed_' + k] && !ok,
      quizChipLabel: 'Pregunta rápida',
      openQuiz: () => this.setState({ ['quizArm_' + k]: true, ['quizClosed_' + k]: false }),
      quizText: q.text,
      quizOpts: ['Verdadero', 'Falso'].map(label => {
        const v = label.toLowerCase();
        const bloq = !!sel && !ok;
        return { label, onClick: bloq ? () => {} : () => this.setState({ ['quiz_' + k]: v }), style: blueBtn(sel === v, v === q.ok, !!sel) + (bloq ? 'cursor:not-allowed;pointer-events:none;' : '') };
