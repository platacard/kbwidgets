      segLoStyle: segBase + 'flex-basis:' + pctLo + '%;background:linear-gradient(135deg,#6E7A90,#A8B2C4);',
      segHiText: pctHi >= 18 ? money0(hi) : '', segLoText: pctLo >= 18 ? money0(lo) : '',
      hiAmt: money0(hi), loAmt: money0(lo), loLabel: 'Bloque 2 · ' + pct0(tasaBaja),
      vDiario: empty ? '—' : money(dTot), vPeriodo: empty ? '—' : money(dTot * CALC.DIAS),
      tHiLabel: empty ? 'Bloque 1 · 15%' : 'Bloque 1 · ' + money0(hi) + ' al ' + pct0(CALC.TASA_ALTA),
      tHiVal: empty ? '—' : money(dHi),
      tLoLabel: empty ? 'Bloque 2 · ' + pct0(tasaBaja) : (lo > 0 ? 'Bloque 2 · ' + money0(lo) + ' al ' + pct0(tasaBaja) : 'Bloque 2 · sin excedente'),
      tLoVal: empty ? '—' : money(dLo),
      tSumVal: empty ? '—' : money(dTot),
      tPondVal: empty ? '—' : pct(dTot * CALC.BASE / saldo),
      steps,
      cBadge: 'Pregunta ' + (cIx + 1) + ' de ' + CASO_QS.length,
      cLead: cQ.lead, cQuote: cQ.quote,
      cAnswered: cAns,
