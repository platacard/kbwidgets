      })
    };
    return out;
  }

  quizOk(k) { return QUIZ[k] && this.state['quiz_' + k] === QUIZ[k].ok; }

  crmTap() {
    const ix = this.state.crmIx || 0;
    if (ix >= 2) return;
    this.setState({ crmIx: ix + 1, crmS: ix + 2 });
  }

  accTog(n) {
    const cur = this.state.crmAcc || {};
    const next = Object.assign({}, cur);
    next[n] = !cur[n];
    this.setState({ crmAcc: next });
  }

  crmResetTour() {
    const k = (SCREENS[this.state.i] || {}).k;
    if (k === 'm4d') { this.setState({ crmAcc: {} }); return; }
    this.setState({ crmS: 1, crmIx: 0 });
  }

  crmElTap(n) {
    const arr = (this.state.crmEl || []).slice();
    if (arr.indexOf(n) < 0) arr.push(n);
    const acc = Object.assign({}, this.state.crmAcc || {});
    if (n === 2) acc[2] = true;
    if (n === 3) acc[6] = true;
    this.setState({ crmEl: arr, crmAcc: acc });
  }

