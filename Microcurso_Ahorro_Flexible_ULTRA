      cRetryGo: () => this.setState({ ['caso_' + cQ.id]: null }),
      cFb: cOk ? cQ.fbOk : cQ.fbNo,
      cFbStyle: 'border-radius:14px;padding:14px 16px;font-size:13.5px;line-height:1.7;' + (cOk ? 'background:#EAF9EF;border:1px solid #BCE8CB;color:#0F7A38;' : 'background:#FDECEC;border:1px solid #F6C9C6;color:#B3261E;'),
      cHintNext: cOk && cIx < CASO_QS.length - 1,
