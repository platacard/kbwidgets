          else if (isSel) s2 = 'width:100%;text-align:left;padding:13px 16px;border-radius:14px;font-family:inherit;font-size:14px;line-height:1.5;font-weight:500;cursor:pointer;border:1px solid #F6C9C6;background:#FDECEC;color:#B3261E;';
