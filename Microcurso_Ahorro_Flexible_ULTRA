  leerProgreso() {
    try {
      const alm = afuStore(); if (!alm) return null;
      const raw = alm.getItem(STORE_KEY); if (!raw) return null;
      const d = JSON.parse(raw);
      if (!d || d.v !== 1 || !d.s) return null;
      const ix = d.s.i;
      if (typeof ix !== 'number' || ix < 0 || ix >= SCREENS.length) return null;
      return d.s;
    } catch (e) { return null; }
