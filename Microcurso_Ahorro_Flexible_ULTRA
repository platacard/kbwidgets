      spotsRoot: (this.state.spotsOn && SCREENS[i] && SCREENS[i].k === 'm3c') ? 'on' : 'off',
      spotsLabel: this.state.spotsOn ? 'Ocultar hotspots interactivos' : 'Mostrar hotspots interactivos',
      spotsBtnStyle: 'display:inline-flex;align-items:center;gap:8px;font-family:inherit;font-size:12.5px;font-weight:700;padding:9px 16px;border-radius:999px;cursor:pointer;transition:all .16s;' + (this.state.spotsOn ? 'background:linear-gradient(135deg,#FF4000,#FF711F);border:1.5px solid transparent;color:#FFFFFF;box-shadow:0 6px 16px rgba(255,80,0,.24);' : 'background:#FFFFFF;border:1.5px solid #FFD3BA;color:#B23800;'),
      toggleSpots: () => this.setState(st2 => ({ spotsOn: !st2.spotsOn })),
      surveyGo: () => this.setState({ surveyOpened: true }),
      retryStyle: 'display:inline-flex;align-items:center;gap:8px;margin-top:14px;padding:10px 20px;border-radius:999px;border:1.5px solid #F3A6A6;background:#FFFFFF;color:#B00020;font-family:inherit;font-size:13.5px;font-weight:700;cursor:pointer',
      showFooter: i > 0, showMeta: i > 0,
      resetAsk: !!this.state.resetAsk,
      askReset: () => this.setState({ resetAsk: true, menuOpen: false }),
      cancelReset: () => this.setState({ resetAsk: false }),
      reset: () => {
        this.borrarProgreso();
        clearTimeout(this._confT); clearTimeout(this._ovT); clearTimeout(this._quizT);
        clearTimeout(this._twq1Text); clearTimeout(this._twq2Text);
        if (this._demoT) { this._demoT.forEach(t => clearTimeout(t)); this._demoT = []; }
        this._typing = false;
        const limpio = {};
        Object.keys(this.state).forEach(kk => { limpio[kk] = null; });
        this.setState(Object.assign(limpio, estadoInicial()), () => this.revealFor(0));
      },
      next: () => {
        if (quizBlocking) return;
        if (QUIZ[qk] && this.quizReady(qk) && !this.state['quizArm_' + qk]) {
          this.setState({ ['quizArm_' + qk]: true, ['quizClosed_' + qk]: false });
          return;
        }
        this.advance();
      },
      prev: () => { if (!quizBlocking) this.goTo(i - 1); },
      nextDisabled: (nextBlocked && !quizArmable) ? 'true' : 'false',
      prevDisabled: prevBlocked ? 'true' : 'false',
      nextStyle: btn((nextBlocked && !quizArmable) || i >= SCREENS.length - 1, 'next'),
      prevStyle: btn(prevBlocked, 'prev'),

      isS0: i === 0, isS1: i === 1, isS2: i === 2, isS3: i === 3,
      isM1a: sc.k === 'm1a', isM1b: sc.k === 'm1b', isM1c: sc.k === 'm1c',
      isM1d: sc.k === 'm1d', isM1d2: sc.k === 'm1d2', isM1e: sc.k === 'm1e',
      isKp: !!KP[sc.k],
      isC1: sc.k === 'c1', isC2: sc.k === 'c2', isC3: sc.k === 'c3',
      isM4a: sc.k === 'm4a',
      plusIcon: PLUS_ICON,
      isM4b: sc.k === 'm4b', isM4c: sc.k === 'm4c', isM4d: sc.k === 'm4d',
      isM4Sim: sc.k === 'm4b' || sc.k === 'm4c' || sc.k === 'm4d',
      m4Kicker: sc.k === 'm4d' ? 'Practica' : 'Proceso',
      m4Title: sc.k === 'm4d' ? 'Simulador del Ahorro Flexible ULTRA en CRM' : (sc.k === 'm4c' ? 'Elementos del Ahorro Flexible ULTRA' : 'Acceso al Ahorro Flexible ULTRA'),
      m4Lead: sc.k === 'm4b'
        ? 'Interactúa con el siguiente simulador para conocer en dónde se alojará esta cuenta en el CRM.'
        : (sc.k === 'm4c'
          ? 'Interactúa con el siguiente simulador para conocer el significado de los principales elementos de la cuenta en el CRM.'
          : 'Responde las siguientes preguntas del cliente sobre el Ahorro Flexible ULTRA con ayuda del simulador interactivo de la izquierda.'),
      ...this.crmVals(),
      confetti: !!this.state.confetti,
      imgLogo: IMGLOGO,
      imgShot: IMGSHOT,
      isM2a: sc.k === 'm2a', isM2b: sc.k === 'm2b', isM2c: sc.k === 'm2c', isM2d: sc.k === 'm2d',
      isM3a: sc.k === 'm3a',
      chatTitle: sent >= 1 ? 'Importancia del microcurso' : 'Pregúntale a Plata',
      chatEmpty: sent === 0,
      q1Sent: sent >= 1, q2Sent: sent >= 2,
      q1Text: this.state.q1Text, q2Text: this.state.q2Text,
      b1: this.bubbleStyle(1, false),
      b2: this.bubbleStyle(1, true),
      b3: this.bubbleStyle(2, true),
      composerActive: sent === 0 || (sent === 1 && !!this.state.q2Ready),
      composerDone: sent >= 2 || (sent === 1 && !this.state.q2Ready),
      composerText: sent === 0 ? this.state.q1Text : (sent === 1 ? this.state.q2Text : ''),
      onComposerInput: (e) => this.setState(sent === 0 ? { q1Text: e.target.value } : { q2Text: e.target.value }),
      sendChat: () => this.sendQuestion()
    });
  }
}

</script>


