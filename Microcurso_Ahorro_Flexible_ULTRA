  escribirEn(campo, texto) {
    clearTimeout(this['_tw' + campo]);
    this._typing = true;
    super.setState({ [campo]: '' });
    let n = 0;
    const paso = () => {
      n++;
      if (n > texto.length) { this._typing = false; return; }
      super.setState({ [campo]: texto.slice(0, n) });
      const ch = texto.charAt(n - 1);
      let d = 42 + Math.random() * 34;          // ritmo base irregular
      if (ch === ' ') d += 26;                   // pausa breve entre palabras
      if ('¿¡'.indexOf(ch) >= 0) d += 40;
      if (',;'.indexOf(ch) >= 0) d += 150;
      if ('.?!'.indexOf(ch) >= 0) d += 220;
      this['_tw' + campo] = setTimeout(paso, d);
    };
    this['_tw' + campo] = setTimeout(paso, 260);
  }

