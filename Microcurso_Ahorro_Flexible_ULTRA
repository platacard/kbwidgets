    if (!d) return { isKpX: false, kpItems: [], kpChapter: '', kpLead: '', kpHasLead: false, kpCount: '' };
    const tapped = st['kp_' + k] || [];
    return {
      kpChapter: d.chapter, kpLead: d.lead || '', kpHasLead: !!d.lead,
      kpCount: tapped.length + ' de ' + d.items.length + ' repasados',
      kpItems: d.items.map((text, ix) => {
        const on = (st.kpN || 0) >= ix + 1;
        const done = tapped.indexOf(ix) >= 0;
        return {
          text, done: done ? 'true' : 'false',
          style: 'display:flex;align-items:center;gap:14px;text-align:right;padding:16px 18px;border-radius:18px;font-family:inherit;cursor:pointer;border:1px solid ' +
            (done ? '#FFD3BA' : '#E3E8F1') + ';background:' + (done ? '#FFF6EF' : '#FFFFFF') +
            ';transition:opacity .5s cubic-bezier(.2,0,0,1),transform .5s cubic-bezier(.2,0,0,1),background .2s,border-color .2s;opacity:' +
            (on ? '1' : '0') + ';transform:' + (on ? 'none' : 'translateY(10px)') + ';',
          iconPath: (KP_ICON[k] || [])[ix] || 'M5 13l4 4L19 7',
          badgeStyle: 'flex:none;width:30px;height:30px;border-radius:999px;display:grid;place-items:center;color:' + (done ? '#fff' : '#A8B2C4') + ';background:' + (done ? GRAD : '#EEF1F7') + ';',
          onClick: () => this.setState(s => {
